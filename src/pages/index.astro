---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCard from '../components/cards/FeaturedCard.astro';
import StandardCard from '../components/cards/StandardCard.astro';
import HorizontalCard from '../components/cards/HorizontalCard.astro';
import CompactCard from '../components/cards/CompactCard.astro';
import TrendingCard from '../components/cards/TrendingCard.astro';
import FollowSection from '../components/FollowSection.astro';
import TagList from '../components/TagList.astro';
import {
  getPublishedArticles,
  getCategories,
  getAllTags,
  articleSlug,
  categoryUrl,
} from '../lib/articles';
import { SITE } from '../lib/site';
import { coverSrcsetWebp } from '../lib/covers';

const all = await getPublishedArticles();
const categories = await getCategories();
const allTags = await getAllTags();

const featured = all.find((a) => a.data.featured) ?? all[0];
const featuredSlug = featured ? articleSlug(featured) : '';
const trending = all.filter((a) => a.data.trending).slice(0, 4);
const latest = all.filter((a) => articleSlug(a) !== featuredSlug).slice(0, 6);
const latestSlugs = new Set(latest.map(articleSlug));
const learn = all.filter((a) => ['tips', 'edukasi'].includes(a.data.category)).slice(0, 3);
const picks = all.filter((a) => ['bisnis', 'lifestyle', 'berita'].includes(a.data.category)).slice(0, 3);
const discovery = all.filter(
  (a) => articleSlug(a) !== featuredSlug && !latestSlugs.has(articleSlug(a)),
);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'id-ID',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/search/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  jsonLd={[websiteJsonLd]}
  preloadImage={
    featured
      ? { srcset: coverSrcsetWebp(featured.data.cover), sizes: '(max-width: 1023px) 100vw, 800px' }
      : undefined
  }
>
  <section class="pt-8 sm:pt-10" aria-label="Tentang XDIRGA BLOG">
    <h1 class="max-w-3xl font-display text-[2rem] leading-[1.15] font-semibold text-text sm:text-[2.6rem]">
      Berita, Teknologi, dan Tips Digital untuk Kehidupan Sehari-hari
    </h1>
    <p class="mt-3 max-w-2xl text-[1.02rem] leading-relaxed text-text-secondary">
      Tulisan soal gaya hidup, edukasi, dan bisnis, ditulis mengalir dari hal yang dicoba sendiri.
    </p>
  </section>

  <section class="mt-8 sm:mt-10" aria-label="Artikel unggulan dan tren">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        {featured && <FeaturedCard post={featured} eager />}
      </div>
      <aside class="rounded-2xl border border-border bg-surface p-5 sm:p-6" aria-label="Artikel tren">
        <h2 class="text-sm font-bold tracking-[0.12em] text-primary uppercase">Sedang Tren</h2>
        <div class="mt-5">
          {trending.map((post, i) => (
            <TrendingCard post={post} rank={i + 1} />
          ))}
        </div>
        <a
          href="/search/"
          class="mt-6 inline-block text-sm font-semibold text-primary transition hover:text-primary-hover"
        >
          Cari tulisan lain →
        </a>
      </aside>
    </div>
  </section>

  <section class="mt-12" aria-label="Jelajahi kategori">
    <div class="flex flex-wrap gap-2.5">
      {
        categories.map((cat) => (
          <a
            href={categoryUrl(cat.id)}
            class="rounded-full border border-border bg-surface px-4 py-2 text-sm font-semibold text-text transition hover:border-primary hover:text-primary"
          >
            {cat.data.name}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-14" aria-label="Artikel terbaru">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-[1.7rem] leading-tight font-semibold text-text sm:text-[2rem]">Terbaru</h2>
      <a href="/kategori/teknologi/" class="shrink-0 text-sm font-semibold text-primary transition hover:text-primary-hover">
        Lihat semua →
      </a>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((post) => (
        <StandardCard post={post} />
      ))}
    </div>
  </section>

  <section class="mt-14" aria-label="Tips dan edukasi">
    <h2 class="font-display text-[1.7rem] leading-tight font-semibold text-text sm:text-[2rem]">Belajar dan Berkembang</h2>
    <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-text-secondary">
      Panduan praktis dan penjelasan yang gampang diikuti, buat yang mau belajar hal baru tanpa ribet.
    </p>
    <div class="mt-6 grid gap-5 lg:grid-cols-2">
      {learn.map((post) => (
        <HorizontalCard post={post} />
      ))}
    </div>
  </section>

  <section class="mt-14" aria-label="Pilihan editor">
    <h2 class="font-display text-[1.7rem] leading-tight font-semibold text-text sm:text-[2rem]">Pilihan Editor</h2>
    <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-text-secondary">
      Tulisan pilihan soal kerja, gaya hidup, dan kabar yang layak dibaca sampai habis.
    </p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {picks.map((post) => (
        <StandardCard post={post} />
      ))}
    </div>
  </section>

  {
    discovery.length > 0 && (
      <section class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px]" aria-label="Jelajahi lebih lanjut">
        <div>
          <h2 class="font-display text-[1.7rem] leading-tight font-semibold text-text sm:text-[2rem]">Jelajahi Lebih Lanjut</h2>
          <div class="mt-6 rounded-2xl border border-border bg-surface p-5 sm:p-6">
            {discovery.map((post) => (
              <CompactCard post={post} />
            ))}
          </div>
        </div>
        <aside>
          <h2 class="text-sm font-bold tracking-[0.12em] text-primary uppercase">Topik Populer</h2>
          <div class="mt-4">
            <TagList tags={allTags.slice(0, 12).map((t) => t.tag)} />
          </div>
          <p class="mt-5 text-sm leading-relaxed text-text-secondary">
            {all.length} tulisan diterbitkan sejauh ini, di {categories.length} kategori.
          </p>
        </aside>
      </section>
    )
  }

  <FollowSection />
</BaseLayout>
