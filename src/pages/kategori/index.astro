---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getPublishedArticles, categoryUrl } from '../../lib/articles';
import { SITE } from '../../lib/site';

const categories = await getCategories();
const all = await getPublishedArticles();
const counts = new Map<string, number>();
for (const article of all) {
  counts.set(article.data.category, (counts.get(article.data.category) ?? 0) + 1);
}
---

<BaseLayout
  title="Kategori"
  description="Jelajahi semua kategori di XDIRGA BLOG."
  hreflang={{ en: new URL('/en/category/', SITE.url).href, id: new URL('/kategori/', SITE.url).href }}
>
  <section class="pt-10 sm:pt-12">
    <h1 class="font-display text-[2.3rem] leading-[1.1] font-semibold text-text sm:text-[2.9rem]">Kategori</h1>
    <p class="mt-3 max-w-2xl text-[1.02rem] leading-relaxed text-text-secondary">
      Semua tulisan dikelompokkan ke dalam kategori supaya gampang dicari.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat) => (
          <a
            href={categoryUrl(cat.id)}
            class="group rounded-2xl border border-border bg-surface p-6 transition hover:border-primary/60 hover:shadow-[0_8px_24px_rgba(16,51,61,0.08)]"
          >
            <h2 class="text-lg font-bold text-text transition group-hover:text-primary">{cat.data.name}</h2>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{cat.data.description}</p>
            <p class="mt-4 text-xs font-semibold text-primary">
              {counts.get(cat.id) ?? 0} tulisan
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
