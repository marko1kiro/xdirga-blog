---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import {
  archivePageDescription,
  getPublishedArticles,
  getAllTags,
  type Article,
  type BreadcrumbItem,
} from '../../../lib/articles';
import { PAGE_SIZE, SITE } from '../../../lib/site';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getPublishedArticles();
  const tags = await getAllTags();
  return tags.flatMap(({ tag }) => {
    const posts = all.filter((a) => a.data.tags.includes(tag));
    return paginate(posts, {
      params: { slug: tag },
      props: { tag },
      pageSize: PAGE_SIZE,
    });
  });
};

interface Props {
  page: Page<Article>;
  tag: string;
}

const { page, tag } = Astro.props;
const featured = page.currentPage === 1 ? page.data[0] : null;
const posts = page.currentPage === 1 ? page.data.slice(1) : page.data;
const pageUrl = (n: number) =>
  n === 1 ? `/tag/${encodeURIComponent(tag)}/` : `/tag/${encodeURIComponent(tag)}/${n}/`;
const pageTitle = page.currentPage > 1 ? `Tag ${tag} (Halaman ${page.currentPage})` : `Tag ${tag}`;
---

<ArchiveLayout
  title={pageTitle}
  description={archivePageDescription(
    `Semua tulisan di XDIRGA BLOG dengan tag ${tag}.`,
    page.currentPage,
    page.lastPage,
    `tulisan dengan tag ${tag}`,
  )}
  heading={`#${tag}`}
  intro={`Semua tulisan dengan tag ${tag}. Total ${page.total} tulisan.`}
  featured={featured}
  posts={posts}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  pageUrl={pageUrl}
  breadcrumb={[
    { label: 'Beranda', href: '/' },
    { label: 'Semua Tag', href: '/tag/' },
    { label: `#${tag}` },
  ] satisfies BreadcrumbItem[]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `Tag ${tag}`,
      url: new URL(`/tag/${encodeURIComponent(tag)}/`, SITE.url).href,
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    },
  ]}
/>
