---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { NEWSLETTER_ENABLED } from '../../lib/newsletter';
import { SITE } from '../../lib/site';
---

<BaseLayout
  title="Contact"
  description="How to reach and follow XDIRGA BLOG."
  lang="en"
  hreflang={{ en: new URL('/en/contact/', SITE.url).href, id: new URL('/kontak/', SITE.url).href }}
>
  <section class="mx-auto max-w-[720px] pt-10 sm:pt-12">
    <h1 class="font-display text-[2.3rem] leading-[1.1] font-semibold text-text sm:text-[2.9rem]">Contact</h1>
    <div class="prose mt-8 max-w-none">
      <p>
        XDIRGA BLOG is a personal publication run by one person. There is no editorial team and no customer service, so please understand if replies cannot be as fast as a commercial service.
      </p>
      <h2>Email</h2>
      <p>
        Email <a href="mailto:admin@xdirga.xyz">admin@xdirga.xyz</a>. Send an email to this address for corrections, topic suggestions, or anything else about this blog.
      </p>
      <h2>The best way to follow this blog</h2>
      <p>
        The easiest way is to subscribe by email. Every new article lands straight in your inbox, without needing to open this site every day.
      </p>
      <p>
        If you spot a mistake in an article or a broken link, the most helpful thing is to note the article title and the part that is wrong, then send an email to <a href="mailto:admin@xdirga.xyz">admin@xdirga.xyz</a>. Corrections are recorded with an update date on the article.
      </p>
      <h2>Topic suggestions</h2>
      <p>
        Topic suggestions are welcome, especially about free tools, APIs, and technical things you are working on. Not every suggestion can be written up, but all of them are read and considered. You can also send suggestions to the email above.
      </p>
    </div>
    {
      NEWSLETTER_ENABLED && (
        <section id="subscribe" class="mt-10">
          <SubscribeForm lang="en" />
        </section>
      )
    }
  </section>
</BaseLayout>
