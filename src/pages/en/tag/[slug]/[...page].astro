---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '../../../../layouts/ArchiveLayout.astro';
import {
  getPublishedArticles,
  getAllTags,
  type Article,
  type BreadcrumbItem,
} from '../../../../lib/articles';
import { PAGE_SIZE, SITE } from '../../../../lib/site';
import { archivePageDescriptionEn, ui } from '../../../../lib/i18n';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getPublishedArticles();
  const tags = await getAllTags();
  return tags.flatMap(({ tag }) => {
    const posts = all.filter((a) => a.data.tags.includes(tag));
    return paginate(posts, {
      params: { slug: tag },
      props: { tag },
      pageSize: PAGE_SIZE,
    });
  });
};

interface Props {
  page: Page<Article>;
  tag: string;
}

const { page, tag } = Astro.props;
const lang = 'en' as const;
const t = ui(lang);
const featured = page.currentPage === 1 ? page.data[0] : null;
const posts = page.currentPage === 1 ? page.data.slice(1) : page.data;
const pageUrl = (n: number) =>
  n === 1 ? `/en/tag/${encodeURIComponent(tag)}/` : `/en/tag/${encodeURIComponent(tag)}/${n}/`;
const idPageUrl = (n: number) =>
  n === 1 ? `/tag/${encodeURIComponent(tag)}/` : `/tag/${encodeURIComponent(tag)}/${n}/`;
const pageTitle = page.currentPage > 1 ? t.tagPageTitlePaged(tag, page.currentPage) : t.tagPageTitle(tag);
---

<ArchiveLayout
  title={pageTitle}
  description={archivePageDescriptionEn(
    t.tagDescBase(tag),
    page.currentPage,
    page.lastPage,
    `articles tagged ${tag}`,
  )}
  heading={`#${tag}`}
  intro={t.tagIntro(tag, page.total)}
  featured={featured}
  posts={posts}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  pageUrl={pageUrl}
  lang={lang}
  hreflang={{
    en: new URL(pageUrl(page.currentPage), SITE.url).href,
    id: new URL(idPageUrl(page.currentPage), SITE.url).href,
  }}
  breadcrumb={[
    { label: t.breadcrumbHome, href: '/en/' },
    { label: t.breadcrumbAllTags, href: '/en/tag/' },
    { label: `#${tag}` },
  ] satisfies BreadcrumbItem[]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `Tag ${tag}`,
      // URL halaman ini sendiri (hal. 1 maupun paginasi), sama dengan canonical.
      url: new URL(pageUrl(page.currentPage), SITE.url).href,
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    },
  ]}
/>
