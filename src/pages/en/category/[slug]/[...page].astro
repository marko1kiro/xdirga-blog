---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '../../../../layouts/ArchiveLayout.astro';
import {
  getPublishedArticles,
  getCategories,
  type Article,
  type BreadcrumbItem,
} from '../../../../lib/articles';
import { PAGE_SIZE, SITE } from '../../../../lib/site';
import { archivePageDescriptionEn, ui } from '../../../../lib/i18n';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getPublishedArticles();
  const categories = await getCategories();
  return categories.flatMap((cat) => {
    const posts = all.filter((a) => a.data.category === cat.id);
    if (posts.length === 0) return [];
    return paginate(posts, {
      params: { slug: cat.id },
      props: { category: cat },
      pageSize: PAGE_SIZE,
    });
  });
};

interface Props {
  page: Page<Article>;
  category: { id: string; data: { name: string; description: string } };
}

const { page, category } = Astro.props;
const { slug } = Astro.params;
const lang = 'en' as const;
const t = ui(lang);
const featured = page.currentPage === 1 ? page.data[0] : null;
const posts = page.currentPage === 1 ? page.data.slice(1) : page.data;
const pageUrl = (n: number) => (n === 1 ? `/en/category/${slug}/` : `/en/category/${slug}/${n}/`);
const idPageUrl = (n: number) => (n === 1 ? `/kategori/${slug}/` : `/kategori/${slug}/${n}/`);
const pageTitle = page.currentPage > 1 ? `${category.data.name} ${t.pageSuffix(page.currentPage)}` : category.data.name;
---

<ArchiveLayout
  title={pageTitle}
  description={archivePageDescriptionEn(
    category.data.description,
    page.currentPage,
    page.lastPage,
    `${category.data.name} articles`,
  )}
  heading={category.data.name}
  intro={category.data.description}
  featured={featured}
  posts={posts}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  pageUrl={pageUrl}
  lang={lang}
  hreflang={{
    en: new URL(pageUrl(page.currentPage), SITE.url).href,
    id: new URL(idPageUrl(page.currentPage), SITE.url).href,
  }}
  breadcrumb={[
    { label: t.breadcrumbHome, href: '/en/' },
    { label: t.breadcrumbCategories, href: '/en/category/' },
    { label: category.data.name },
  ] satisfies BreadcrumbItem[]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: category.data.name,
      description: category.data.description,
      // URL halaman ini sendiri (hal. 1 maupun paginasi), sama dengan canonical.
      url: new URL(pageUrl(page.currentPage), SITE.url).href,
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    },
  ]}
/>
