---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles, getCategories, articleUrl } from '../../lib/articles';
import {
  getAllTools,
  TOOL_CATEGORIES,
  toolUrl,
  categoryUrl as toolCategoryUrl,
  toolsIndexUrl,
  editorialPolicyUrl,
} from '../../lib/tools';
import { categoryUrlFor, formatDateShortLang, ui } from '../../lib/i18n';
import { SITE } from '../../lib/site';

const lang = 'en' as const;
const t = ui(lang);

const articles = await getPublishedArticles();
const categories = await getCategories();
const tools = await getAllTools();

const groups = categories
  .map((cat) => ({
    id: cat.id,
    name: cat.data.name,
    url: categoryUrlFor(cat.id, lang),
    items: articles.filter((a) => a.data.category === cat.id),
  }))
  .filter((g) => g.items.length > 0);

const mainPages = [
  { label: 'Home', href: '/en/' },
  { label: 'About', href: '/en/about/' },
  { label: 'Contact', href: '/en/contact/' },
  { label: 'Search', href: '/en/search/' },
  { label: 'Privacy', href: '/en/privacy/' },
  { label: 'Terms', href: '/en/terms/' },
];
---

<BaseLayout
  title={t.sitemapTitle}
  description={t.sitemapDesc}
  lang={lang}
  hreflang={{ en: new URL('/en/sitemap/', SITE.url).href, id: new URL('/sitemap/', SITE.url).href }}
>
  <section class="mx-auto max-w-[720px] pt-10 sm:pt-12">
    <h1 class="font-display text-[2.3rem] leading-[1.1] font-semibold text-text sm:text-[2.9rem]">{t.sitemapTitle}</h1>
    <p class="mt-3 leading-relaxed text-text-secondary">
      {t.sitemapIntro}
    </p>

    <h2 class="mt-10 text-xl font-bold text-text">{t.sitemapPages}</h2>
    <ul class="mt-4 space-y-2.5 text-sm">
      {
        mainPages.map((page) => (
          <li>
            <a href={page.href} class="text-primary hover:underline">
              {page.label}
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-10 text-xl font-bold text-text">
      <a href={toolsIndexUrl('en')} class="transition hover:text-primary">
        Tools
      </a>
    </h2>
    <ul class="mt-4 space-y-2.5 text-sm">
      <li>
        <a href={toolsIndexUrl('en')} class="text-primary hover:underline">
          {t.sitemapToolsEn}
        </a>
        {' · '}
        <a href={toolsIndexUrl('id')} class="text-primary hover:underline">
          {t.sitemapToolsId}
        </a>
      </li>
      <li>
        <a href={editorialPolicyUrl('en')} class="text-primary hover:underline">
          Editorial Policy
        </a>
        {' · '}
        <a href={editorialPolicyUrl('id')} class="text-primary hover:underline">
          Kebijakan Editorial
        </a>
      </li>
      {
        TOOL_CATEGORIES.map((cat) => (
          <li>
            <a href={toolCategoryUrl(cat.slug, 'en')} class="text-primary hover:underline">
              {cat.labelEn}
            </a>
            {' · '}
            <a href={toolCategoryUrl(cat.slug, 'id')} class="text-primary hover:underline">
              {cat.labelId}
            </a>
          </li>
        ))
      }
      {
        tools.map((tool) => (
          <li>
            <a href={toolUrl(tool, 'en')} class="font-medium text-text transition hover:text-primary">
              {tool.data.name}
            </a>
            {' · '}
            <a href={toolUrl(tool, 'id')} class="text-primary hover:underline">
              ID
            </a>
          </li>
        ))
      }
    </ul>

    {
      groups.map((group) => (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-text">
            <a href={group.url} class="transition hover:text-primary">
              {group.name}
            </a>
          </h2>
          <ul class="mt-4 space-y-3 text-sm">
            {group.items.map((article) => (
              <li class="flex flex-wrap items-baseline gap-x-3">
                <a href={articleUrl(article)} class="font-medium text-text transition hover:text-primary">
                  {article.data.title}
                </a>
                <span class="text-xs text-text-secondary">{formatDateShortLang(article.data.publishedAt, lang)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</BaseLayout>
