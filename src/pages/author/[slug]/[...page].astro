---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StandardCard from '../../../components/cards/StandardCard.astro';
import { getCollection } from 'astro:content';
import {
  archivePageDescription,
  breadcrumbJsonLd,
  categoryUrl,
  getCategories,
  getPublishedArticles,
  tagUrl,
  type Article,
  type BreadcrumbItem,
} from '../../../lib/articles';
import { PAGE_SIZE, SITE } from '../../../lib/site';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const authors = await getCollection('authors');
  const all = await getPublishedArticles();
  return authors.flatMap((author) => {
    const posts = all.filter((a) => a.data.author === author.id);
    return paginate(posts, {
      params: { slug: author.id },
      props: { author },
      pageSize: PAGE_SIZE,
    });
  });
};

interface Props {
  page: Page<Article>;
  author: { id: string; data: { name: string; role?: string; bio: string; avatar: string; website?: string } };
}

const { page, author } = Astro.props;
const { slug } = Astro.params;
const pageUrl = (n: number) => (n === 1 ? `/author/${slug}/` : `/author/${slug}/${n}/`);
const enPageUrl = (n: number) => (n === 1 ? `/en/author/${slug}/` : `/en/author/${slug}/${n}/`);
const pageTitle = page.currentPage > 1 ? `${author.data.name} (Halaman ${page.currentPage})` : author.data.name;

const breadcrumbItems: BreadcrumbItem[] = [{ label: 'Beranda', href: '/' }, { label: author.data.name }];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.data.name,
  description: author.data.bio,
  url: new URL(`/author/${slug}/`, SITE.url).href,
  ...(author.data.role ? { jobTitle: author.data.role } : {}),
  ...(author.data.website ? { sameAs: [author.data.website] } : {}),
};

// Topik yang sering ditulis, dihitung dari seluruh artikel author (bukan
// cuma halaman ini) supaya angkanya tidak berubah antar halaman.
const allAuthorPosts = (await getPublishedArticles()).filter((a) => a.data.author === author.id);
const categories = await getCategories();
const categoryName = new Map(categories.map((c) => [c.id, c.data.name]));
const categoryCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
for (const post of allAuthorPosts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
  for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const topCategories = [...categoryCounts.entries()]
  .map(([id, count]) => ({ id, name: categoryName.get(id) ?? id, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'id'));
const topTags = [...tagCounts.entries()]
  .map(([tag, count]) => ({ tag, count }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, 'id'))
  .slice(0, 8);
---

<BaseLayout
  title={pageTitle}
  description={archivePageDescription(
    author.data.bio,
    page.currentPage,
    page.lastPage,
    `tulisan oleh ${author.data.name}`,
  )}
  hreflang={{
    en: new URL(enPageUrl(page.currentPage), SITE.url).href,
    id: new URL(pageUrl(page.currentPage), SITE.url).href,
  }}
  jsonLd={[personJsonLd, breadcrumbJsonLd(breadcrumbItems, SITE.url)]}
>
  <div class="pt-8 sm:pt-10">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="mt-6">
    <div class="flex flex-col gap-5 rounded-2xl border border-border bg-surface-secondary p-6 sm:flex-row sm:items-start sm:p-8">
      <img
        src={author.data.avatar}
        alt={`Avatar ${author.data.name}`}
        width="96"
        height="96"
        loading="eager"
        decoding="async"
        class="h-24 w-24 shrink-0 rounded-full border border-border object-cover"
      />
      <div>
        <h1 class="font-display text-[2rem] leading-tight font-semibold text-text sm:text-[2.4rem]">{author.data.name}</h1>
        {author.data.role && <p class="mt-1 text-sm font-medium text-primary">{author.data.role}</p>}
        <p class="mt-3 max-w-2xl leading-relaxed text-text-secondary">{author.data.bio}</p>
        {
          author.data.website && (
            <a
              href={author.data.website}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-block text-sm font-semibold text-primary transition hover:text-primary-hover"
            >
              {author.data.website} →
            </a>
          )
        }
        <p class="mt-4 text-sm font-semibold text-text">{page.total} tulisan diterbitkan</p>
      </div>
    </div>
  </section>

  {
    (topCategories.length > 0 || topTags.length > 0) && (
      <section class="mt-10" aria-label="Topik yang sering ditulis">
        <h2 class="text-sm font-bold tracking-[0.12em] text-primary uppercase">Topik yang sering ditulis</h2>
        {topCategories.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2.5">
            {topCategories.map((cat) => (
              <a
                href={categoryUrl(cat.id)}
                class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm font-semibold text-text transition hover:border-primary hover:text-primary"
              >
                {cat.name}
                <span class="rounded-full bg-accent-soft px-2 py-0.5 text-xs font-bold text-primary">{cat.count}</span>
              </a>
            ))}
          </div>
        )}
        {topTags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {topTags.map(({ tag, count }) => (
              <a
                href={tagUrl(tag)}
                class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold text-text-secondary transition hover:border-primary hover:text-primary"
              >
                #{tag}
                <span class="font-bold text-primary">{count}</span>
              </a>
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="mt-10" aria-label={`Tulisan oleh ${author.data.name}`}>
    {
      page.data.length === 0 ? (
        <p class="py-10 text-text-secondary">Belum ada tulisan dari penulis ini.</p>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((post) => (
            <StandardCard post={post} />
          ))}
        </div>
      )
    }
  </section>

  {
    page.lastPage > 1 && (
      <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
        {page.currentPage > 1 && (
          <a
            href={pageUrl(page.currentPage - 1)}
            class="rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-text transition hover:border-primary hover:text-primary"
          >
            ← Sebelumnya
          </a>
        )}
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
          <a
            href={pageUrl(n)}
            aria-current={n === page.currentPage ? 'page' : undefined}
            class:list={[
              'rounded-xl border px-4 py-2.5 text-sm font-semibold transition',
              n === page.currentPage
                ? 'border-primary bg-primary text-white'
                : 'border-border bg-surface text-text hover:border-primary hover:text-primary',
            ]}
          >
            {n}
          </a>
        ))}
        {page.currentPage < page.lastPage && (
          <a
            href={pageUrl(page.currentPage + 1)}
            class="rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-text transition hover:border-primary hover:text-primary"
          >
            Berikutnya →
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>
