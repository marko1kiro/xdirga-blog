---
import type { GetStaticPaths } from 'astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ToolsListing from '../../../components/tools/ToolsListing.astro';
import ToolsSidebar from '../../../components/tools/ToolsSidebar.astro';
import ToolsLayout from '../../../layouts/ToolsLayout.astro';
import { getAllTools } from '../../../lib/tools';
import {
  TOOLS_PAGE_SIZE,
  buildCategoryNav,
  countByPlatform,
  countByPricing,
  distinctAudiences,
  toolsHomeUrl,
  toolsPageUrl,
  type Lang,
} from '../../../lib/tools-ui';
import { SITE } from '../../../lib/site';
import type { BreadcrumbItem } from '../../../lib/articles';

export const getStaticPaths: GetStaticPaths = async () => {
  const allTools = await getAllTools();
  const lastPage = Math.max(1, Math.ceil(allTools.length / TOOLS_PAGE_SIZE));
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => {
    const page = i + 2;
    const tools = allTools.slice((page - 1) * TOOLS_PAGE_SIZE, page * TOOLS_PAGE_SIZE);
    return { params: { page: String(page) }, props: { page, tools, totalCount: allTools.length, lastPage } };
  });
};

interface Props {
  page: number;
  tools: import('../../../lib/tools').Tool[];
  totalCount: number;
  lastPage: number;
}

const lang: Lang = 'en';
const { page, tools, totalCount, lastPage } = Astro.props;
const allTools = await getAllTools();
const pageUrl = (n: number) => toolsPageUrl(n, lang);
const canonical = new URL(pageUrl(page), SITE.url).href;

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: toolsHomeUrl(lang) },
  { label: `Page ${page}` },
] satisfies BreadcrumbItem[];
---

<ToolsLayout
  title={`Tools — Page ${page}`}
  description={`Browse the XDIRGA TOOLS directory, page ${page} of ${lastPage}. A curated directory of digital tools for modern work and creativity.`}
  lang={lang}
  canonical={canonical}
  hreflang={{ en: canonical, id: new URL(`/id/tools/page/${page}/`, SITE.url).href }}
>
  <ToolsSidebar
    slot="sidebar"
    categories={buildCategoryNav(allTools, lang)}
    allHref={toolsHomeUrl(lang)}
    allCount={totalCount}
    lang={lang}
    pricingCounts={countByPricing(allTools)}
    platformCounts={countByPlatform(allTools)}
    audiences={distinctAudiences(allTools, lang)}
  />

  <Breadcrumb items={breadcrumb} />
  <h1 class="mt-6 font-display text-[2.3rem] font-semibold leading-[1.1] text-text sm:text-[2.9rem]">
    All Tools
  </h1>
  <p class="mt-3 max-w-2xl text-[1.02rem] leading-relaxed text-text-secondary">
    Page {page} of {lastPage} — {totalCount} tools listed in the directory.
  </p>

  <div class="mt-8">
    <ToolsListing
      lang={lang}
      tools={tools}
      totalCount={totalCount}
      currentPage={page}
      lastPage={lastPage}
      pageUrl={pageUrl}
      heading={null}
    />
  </div>
</ToolsLayout>
