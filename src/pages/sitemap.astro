---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  getPublishedArticles,
  getCategories,
  getAllTags,
  articleUrl,
  categoryUrl,
  tagUrl,
  authorUrl,
  formatDateShort,
} from '../lib/articles';
import {
  getAllTools,
  TOOL_CATEGORIES,
  toolUrl,
  categoryUrl as toolCategoryUrl,
  toolsIndexUrl,
  editorialPolicyUrl,
} from '../lib/tools';
import { SITE } from '../lib/site';

const articles = await getPublishedArticles();
const categories = await getCategories();
const tools = await getAllTools();
const allTags = await getAllTags();
const authors = await getCollection('authors');

// Halaman EN (prefix /en/) dan pasangan ID-nya — peta URL brief i18n §1.
// /en/page/<n>/ TIDAK dicantumkan: /page/<n>/ tidak punya padanan ID di kode
// saat ini (paginasi hanya di dalam arsip kategori/tag/author).
const enPages = [
  { labelEn: 'Home', labelId: 'Beranda', hrefEn: '/en/', hrefId: '/' },
  { labelEn: 'About', labelId: 'Tentang', hrefEn: '/en/about/', hrefId: '/tentang/' },
  { labelEn: 'Contact', labelId: 'Kontak', hrefEn: '/en/contact/', hrefId: '/kontak/' },
  { labelEn: 'Search', labelId: 'Cari', hrefEn: '/en/search/', hrefId: '/search/' },
  { labelEn: 'Privacy', labelId: 'Privasi', hrefEn: '/en/privacy/', hrefId: '/privasi/' },
  { labelEn: 'Terms', labelId: 'Syarat', hrefEn: '/en/terms/', hrefId: '/syarat/' },
  { labelEn: 'Sitemap', labelId: 'Sitemap', hrefEn: '/en/sitemap/', hrefId: '/sitemap/' },
];

const groups = categories
  .map((cat) => ({
    id: cat.id,
    name: cat.data.name,
    url: categoryUrl(cat.id),
    items: articles.filter((a) => a.data.category === cat.id),
  }))
  .filter((g) => g.items.length > 0);

const mainPages = [
  { label: 'Beranda', href: '/' },
  { label: 'About', href: '/tentang/' },
  { label: 'Kontak', href: '/kontak/' },
  { label: 'Cari', href: '/search/' },
  { label: 'Privacy', href: '/privasi/' },
  { label: 'Terms', href: '/syarat/' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<BaseLayout title="Sitemap" description="Daftar semua halaman dan artikel di XDIRGA BLOG, dikelompokkan per kategori." hreflang={{ en: new URL('/en/sitemap/', SITE.url).href, id: new URL('/sitemap/', SITE.url).href }}>
  <section class="mx-auto max-w-[720px] pt-10 sm:pt-12">
    <h1 class="font-display text-[2.3rem] leading-[1.1] font-semibold text-text sm:text-[2.9rem]">Sitemap</h1>
    <p class="mt-3 leading-relaxed text-text-secondary">
      Daftar semua halaman di blog ini, dikelompokkan per kategori supaya gampang dicari.
    </p>

    <h2 class="mt-10 text-xl font-bold text-text">Halaman</h2>
    <ul class="mt-4 space-y-2.5 text-sm">
      {
        mainPages.map((page) => (
          <li>
            <a href={page.href} class="text-primary hover:underline">
              {page.label}
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-10 text-xl font-bold text-text">
      <a href={toolsIndexUrl('en')} class="transition hover:text-primary">
        Tools
      </a>
    </h2>
    <ul class="mt-4 space-y-2.5 text-sm">
      <li>
        <a href={toolsIndexUrl('en')} class="text-primary hover:underline">
          Tools (English)
        </a>
        {' · '}
        <a href={toolsIndexUrl('id')} class="text-primary hover:underline">
          Tools (Bahasa Indonesia)
        </a>
      </li>
      <li>
        <a href={editorialPolicyUrl('en')} class="text-primary hover:underline">
          Editorial Policy
        </a>
        {' · '}
        <a href={editorialPolicyUrl('id')} class="text-primary hover:underline">
          Kebijakan Editorial
        </a>
      </li>
      {
        TOOL_CATEGORIES.map((cat) => (
          <li>
            <a href={toolCategoryUrl(cat.slug, 'en')} class="text-primary hover:underline">
              {cat.labelEn}
            </a>
            {' · '}
            <a href={toolCategoryUrl(cat.slug, 'id')} class="text-primary hover:underline">
              {cat.labelId}
            </a>
          </li>
        ))
      }
      {
        tools.map((tool) => (
          <li>
            <a href={toolUrl(tool, 'en')} class="font-medium text-text transition hover:text-primary">
              {tool.data.name}
            </a>
            {' · '}
            <a href={toolUrl(tool, 'id')} class="text-primary hover:underline">
              ID
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-10 text-xl font-bold text-text">Halaman (English)</h2>
    <p class="mt-3 leading-relaxed text-text-secondary">
      English versions of the blog pages. Article titles stay in Indonesian.
    </p>
    <ul class="mt-4 space-y-2.5 text-sm">
      {
        enPages.map((page) => (
          <li>
            <a href={page.hrefEn} class="text-primary hover:underline">
              {page.labelEn}
            </a>
            {' · '}
            <a href={page.hrefId} class="text-primary hover:underline">
              {page.labelId}
            </a>
          </li>
        ))
      }
      {
        groups.map((group) => (
          <li>
            <a href={`/en/category/${group.id}/`} class="text-primary hover:underline">
              {group.name} (EN)
            </a>
            {' · '}
            <a href={group.url} class="text-primary hover:underline">
              {group.name}
            </a>
          </li>
        ))
      }
      {
        allTags.map(({ tag }) => (
          <li>
            <a href={`/en/tag/${encodeURIComponent(tag)}/`} class="text-primary hover:underline">
              #{tag} (EN)
            </a>
            {' · '}
            <a href={tagUrl(tag)} class="text-primary hover:underline">
              #{tag}
            </a>
          </li>
        ))
      }
      {
        authors.map((author) => (
          <li>
            <a href={`/en/author/${author.id}/`} class="text-primary hover:underline">
              {author.data.name} (EN)
            </a>
            {' · '}
            <a href={authorUrl(author.id)} class="text-primary hover:underline">
              {author.data.name}
            </a>
          </li>
        ))
      }
    </ul>

    {
      groups.map((group) => (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-text">
            <a href={group.url} class="transition hover:text-primary">
              {group.name}
            </a>
          </h2>
          <ul class="mt-4 space-y-3 text-sm">
            {group.items.map((article) => (
              <li class="flex flex-wrap items-baseline gap-x-3">
                <a href={articleUrl(article)} class="font-medium text-text transition hover:text-primary">
                  {article.data.title}
                </a>
                <span class="text-xs text-text-secondary">{formatDateShort(article.data.publishedAt)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</BaseLayout>
