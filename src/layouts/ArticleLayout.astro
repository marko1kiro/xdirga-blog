---
import BaseLayout from './BaseLayout.astro';
import CoverImage from '../components/CoverImage.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import TagList from '../components/TagList.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ArticleTOC from '../components/ArticleTOC.astro';
import AuthorBox from '../components/AuthorBox.astro';
import PrevNext from '../components/PrevNext.astro';
import RelatedArticleCard from '../components/cards/RelatedArticleCard.astro';
import { SITE } from '../lib/site';
import {
  articleUrl,
  categoryUrl,
  getCategory,
  tocFromBody,
  type Article,
} from '../lib/articles';

interface Props {
  post: Article;
  prev: Article | null;
  next: Article | null;
  related: Article[];
}

const { post, prev, next, related } = Astro.props;
const { title, description, category, tags, cover, coverAlt, coverCaption } = post.data;
const categoryData = await getCategory(category);
const categoryName = categoryData?.data.name ?? category;
const toc = tocFromBody(post.body ?? '');
const canonical = post.data.canonicalURL ?? new URL(articleUrl(post), SITE.url).href;
const seoTitle = post.data.seoTitle ?? title;
const seoDescription = post.data.seoDescription ?? description;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(cover, SITE.url).href,
  author: { '@type': 'Person', name: 'XDIRGA', url: new URL('/author/xdirga/', SITE.url).href },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'id-ID',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', SITE.url).href },
    { '@type': 'ListItem', position: 2, name: categoryName, item: new URL(categoryUrl(category), SITE.url).href },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  type="article"
  image={cover}
  canonical={canonical}
  noindex={post.data.noindex}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <div id="progress-bar" class="fixed inset-x-0 top-0 z-50 h-[3px] origin-left scale-x-0 bg-primary" aria-hidden="true"></div>

  <article class="pt-8 sm:pt-10">
    <nav aria-label="Breadcrumb" class="text-sm text-text-secondary">
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
        <li><a href="/" class="transition hover:text-primary">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={categoryUrl(category)} class="transition hover:text-primary">{categoryName}</a></li>
        <li aria-hidden="true">/</li>
        <li class="line-clamp-1 max-w-[16rem] text-text sm:max-w-md" aria-current="page">{title}</li>
      </ol>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-12">
      <div class="min-w-0">
        <a
          href={categoryUrl(category)}
          class="inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-bold tracking-[0.1em] text-primary uppercase"
        >
          {categoryName}
        </a>
        <h1 class="mt-4 font-display text-[2.15rem] leading-[1.12] font-semibold tracking-[-0.01em] text-text sm:text-[2.75rem]">
          {title}
        </h1>
        <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-text-secondary sm:text-lg">
          {description}
        </p>
        <ArticleMeta post={post} />
        <CoverImage src={cover} alt={coverAlt} caption={coverCaption} eager />

        <div class="prose mt-9 max-w-none">
          <slot />
        </div>

        <div class="mt-10 border-t border-border pt-6">
          <TagList tags={tags} />
        </div>

        <AuthorBox post={post} />
        <PrevNext prev={prev} next={next} />
      </div>

      <aside class="min-w-0 lg:sticky lg:top-24 lg:self-start" aria-label="Sidebar artikel">
        <div class="flex flex-col gap-8 rounded-2xl border border-border bg-surface-secondary p-5 sm:p-6 lg:bg-transparent lg:p-0 lg:border-0 lg:rounded-none">
          <ShareButtons url={canonical} title={title} />
          <ArticleTOC items={toc} />
          {
            tags.length > 0 && (
              <div>
                <h2 class="text-sm font-bold tracking-wide text-text">Tag</h2>
                <div class="mt-3">
                  <TagList tags={tags} />
                </div>
              </div>
            )
          }
          {
            related.length > 0 && (
              <div>
                <h2 class="text-sm font-bold tracking-wide text-text">Artikel Terkait</h2>
                <div class="mt-4 flex flex-col gap-5">
                  {related.map((rel) => (
                    <RelatedArticleCard post={rel} />
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16" aria-label="Artikel terkait lainnya">
          <h2 class="font-display text-2xl font-semibold text-text sm:text-[1.7rem]">Mungkin juga menarik</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((rel) => (
              <RelatedArticleCard post={rel} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    var bar = document.getElementById('progress-bar');
    if (!bar) return;
    function update() {
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      var p = max > 0 ? h.scrollTop / max : 0;
      bar.style.transform = 'scaleX(' + p + ')';
    }
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  })();
</script>
