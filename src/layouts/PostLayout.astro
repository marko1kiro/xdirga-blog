---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  minutes: number;
}

const { post, minutes } = Astro.props;
const { title, date, description, tags } = post.data;
const dateStr = date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} type="article">
  <article class="pt-10">
    <a href="/" class="text-sm text-accent hover:underline">← Semua tulisan</a>
    <h1 class="mt-6 font-display text-4xl leading-tight font-bold text-slate-900 sm:text-5xl dark:text-white">
      {title}
    </h1>
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500 dark:text-slate-400">
      <time datetime={date.toISOString()}>{dateStr}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} menit baca</span>
    </div>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}/`}
            class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600 transition hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-300"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
    <div
      class="prose prose-slate mt-8 max-w-none prose-headings:font-display prose-headings:text-slate-900 prose-a:text-accent prose-a:no-underline hover:prose-a:underline dark:prose-invert dark:prose-headings:text-white"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
