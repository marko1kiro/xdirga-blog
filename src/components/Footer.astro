---
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';
import {
  categoryUrlFor,
  footerStaticLinks,
  homeUrl,
  tagsIndexUrl,
  ui,
  type Lang,
} from '../lib/i18n';

interface Props {
  /** Bahasa halaman; default 'id' (semua halaman lama tidak berubah). */
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = ui(lang);

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
---

<footer class="border-t border-border bg-surface-secondary/60">
  <div class="mx-auto grid w-full max-w-[1280px] gap-10 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <a href={homeUrl(lang)} class="inline-flex items-center" aria-label={t.logoHome}>
        <img
          src="/logo-xdirga-blog-light.png"
          alt="XDIRGA BLOG"
          width="880"
          height="146"
          loading="lazy"
          class="block h-9 w-auto dark:hidden"
        />
        <img
          src="/logo-xdirga-blog-dark.png"
          alt="XDIRGA BLOG"
          width="880"
          height="146"
          loading="lazy"
          class="hidden h-9 w-auto dark:block"
        />
      </a>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-text-secondary">{t.footerTagline}</p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-text-secondary">
        {t.footerAbout}
      </p>
      <a
        href="/rss.xml"
        class="mt-5 inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3.5 py-2 text-sm font-medium text-text transition hover:border-primary hover:text-primary"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
        {t.footerRss}
      </a>
    </div>

    <nav aria-label={t.footerCategoriesAria}>
      <h2 class="text-sm font-bold tracking-wide text-text">{t.footerCategories}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          categories.map((cat) => (
            <li>
              <a href={categoryUrlFor(cat.id, lang)} class="text-text-secondary transition hover:text-primary">
                {cat.data.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href={tagsIndexUrl(lang)} class="text-text-secondary transition hover:text-primary">
            {t.footerAllTags}
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-label={t.footerLinksAria}>
      <h2 class="text-sm font-bold tracking-wide text-text">{t.footerLinks}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          footerStaticLinks(lang).map((link) => (
            <li>
              <a href={link.href} class="text-text-secondary transition hover:text-primary">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto w-full max-w-[1280px] px-5 py-5 text-center text-[0.8rem] text-text-secondary">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
    </div>
  </div>
</footer>
