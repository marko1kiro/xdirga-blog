---
import { getCollection } from 'astro:content';
import { categoryUrl } from '../lib/articles';
import { SITE, FOOTER_STATIC } from '../lib/site';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
---

<footer class="border-t border-border bg-surface-secondary/60">
  <div class="mx-auto grid w-full max-w-[1280px] gap-10 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="text-xl font-extrabold tracking-tight text-text">
        XDIRGA <span class="rounded-md bg-primary px-1.5 py-0.5 align-middle text-[0.65rem] font-bold tracking-[0.14em] text-white">BLOG</span>
      </p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-text-secondary">{SITE.tagline}</p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-text-secondary">
        Publikasi digital independen. Ditulis mengalir, dari hal yang dicoba sendiri, tanpa paywall dan tanpa iklan.
      </p>
      <a
        href="/rss.xml"
        class="mt-5 inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3.5 py-2 text-sm font-medium text-text transition hover:border-primary hover:text-primary"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
        Ikuti lewat RSS
      </a>
    </div>

    <nav aria-label="Kategori di footer">
      <h2 class="text-sm font-bold tracking-wide text-text">Kategori</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          categories.map((cat) => (
            <li>
              <a href={categoryUrl(cat.id)} class="text-text-secondary transition hover:text-primary">
                {cat.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Tautan footer">
      <h2 class="text-sm font-bold tracking-wide text-text">Tautan</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          FOOTER_STATIC.map((link) => (
            <li>
              <a href={link.href} class="text-text-secondary transition hover:text-primary">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/search/" class="text-text-secondary transition hover:text-primary">Cari</a>
        </li>
        <li>
          <a href="/tag/" class="text-text-secondary transition hover:text-primary">Semua Tag</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-2 px-5 py-5 text-[0.8rem] text-text-secondary sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name}. Semua tulisan gratis dibaca.</p>
      <p>
        Dibangun dengan <a href="https://astro.build" class="font-medium text-primary hover:underline">Astro</a>
      </p>
    </div>
  </div>
</footer>
