---
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85">
  <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-5 py-4">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-display text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        <span class="text-accent-bright">X</span>DIRGA
      </span>
    </a>
    <nav class="flex items-center gap-4 text-sm sm:gap-6">
      <a href="/" class="text-slate-600 transition hover:text-accent dark:text-slate-300">Beranda</a>
      <a href="/tags/" class="text-slate-600 transition hover:text-accent dark:text-slate-300">Tag</a>
      <a href="/search/" class="text-slate-600 transition hover:text-accent dark:text-slate-300">Cari</a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Ganti tema"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 text-slate-600 transition hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-300"
      >
        <span class="dark:hidden">☾</span>
        <span class="hidden dark:inline">☀</span>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('xdirga-theme', dark ? 'dark' : 'light');
      } catch (e) {}
    });
  })();
</script>
