---
import { getCollection } from 'astro:content';
import { getPublishedArticles } from '../lib/articles';
import { buildNavigation } from '../config/navigation';
import DesktopNavigation from './navigation/DesktopNavigation.astro';
import MobileNavigation from './navigation/MobileNavigation.astro';

const allCategories = await getCollection('categories');
const articles = await getPublishedArticles();
const navItems = buildNavigation(allCategories, articles);
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/90 backdrop-blur">
  <div class="mx-auto flex w-full max-w-[1280px] items-center justify-between gap-4 px-5 py-3.5">
    <a href="/" class="flex shrink-0 items-baseline gap-1.5" aria-label="XDIRGA BLOG, ke beranda">
      <span class="text-[1.55rem] font-extrabold leading-none tracking-tight text-text">
        XDIRGA
      </span>
      <span class="rounded-md bg-primary px-1.5 py-0.5 text-[0.7rem] font-bold leading-none tracking-[0.14em] text-white">
        BLOG
      </span>
    </a>

    <DesktopNavigation items={navItems} currentPath={currentPath} />

    <div class="flex items-center gap-2">
      <a
        href="/search/"
        aria-label="Cari artikel"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-secondary transition hover:border-primary hover:text-primary"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.5" y2="16.5" />
        </svg>
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Ganti tema"
        title="Ganti tema"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-secondary transition hover:border-primary hover:text-primary"
      >
        <span data-theme-icon="light" class="hidden" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <line x1="12" y1="2" x2="12" y2="4" />
            <line x1="12" y1="20" x2="12" y2="22" />
            <line x1="4.9" y1="4.9" x2="6.3" y2="6.3" />
            <line x1="17.7" y1="17.7" x2="19.1" y2="19.1" />
            <line x1="2" y1="12" x2="4" y2="12" />
            <line x1="20" y1="12" x2="22" y2="12" />
            <line x1="4.9" y1="19.1" x2="6.3" y2="17.7" />
            <line x1="17.7" y1="6.3" x2="19.1" y2="4.9" />
          </svg>
        </span>
        <span data-theme-icon="dark" class="hidden" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </span>
        <span data-theme-icon="system" class="hidden" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <line x1="8" y1="21" x2="16" y2="21" />
            <line x1="12" y1="17" x2="12" y2="21" />
          </svg>
        </span>
      </button>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-text-secondary transition hover:border-primary hover:text-primary lg:hidden"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Drawer seluler: sibling <header>, bukan anaknya, supaya position: fixed
     tidak terjebak containing block dari backdrop-blur header. -->
<MobileNavigation items={navItems} currentPath={currentPath} />

<script is:inline>
  (function () {
    var MODES = ['light', 'dark', 'system'];
    var LABELS = {
      light: 'Tema terang, klik untuk tema gelap',
      dark: 'Tema gelap, klik untuk tema sistem',
      system: 'Tema mengikuti sistem, klik untuk tema terang',
    };
    function stored() {
      try {
        return localStorage.getItem('xdirga-theme') || 'system';
      } catch (e) {
        return 'system';
      }
    }
    function apply(mode) {
      var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var dark = mode === 'dark' || (mode === 'system' && systemDark);
      document.documentElement.classList.toggle('dark', dark);
      var btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.setAttribute('aria-label', LABELS[mode] || LABELS.system);
        btn.setAttribute('title', LABELS[mode] || LABELS.system);
        btn.querySelectorAll('[data-theme-icon]').forEach(function (el) {
          el.classList.toggle('hidden', el.getAttribute('data-theme-icon') !== mode);
        });
      }
    }
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      apply(stored());
      btn.addEventListener('click', function () {
        var current = stored();
        var next = MODES[(MODES.indexOf(current) + 1) % MODES.length];
        try {
          localStorage.setItem('xdirga-theme', next);
        } catch (e) {}
        apply(next);
      });
    }
    try {
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', function () {
          if (stored() === 'system') apply('system');
        });
    } catch (e) {}
  })();
</script>
