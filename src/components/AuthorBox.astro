---
import type { Article } from '../lib/articles';
import { getAuthor, authorUrl } from '../lib/articles';

interface Props {
  post: Article;
}

const { post } = Astro.props;
const author = await getAuthor(post.data.author);
if (!author) throw new Error(`Author "${post.data.author}" tidak ditemukan di src/content/authors/.`);
---

<section class="mt-12 flex flex-col gap-4 rounded-2xl border border-border bg-surface-secondary p-6 sm:flex-row sm:items-start" aria-label="Tentang penulis">
  <img
    src={author.data.avatar}
    alt={`Avatar ${author.data.name}`}
    width="64"
    height="64"
    loading="lazy"
    decoding="async"
    class="h-16 w-16 shrink-0 rounded-full border border-border object-cover"
  />
  <div>
    <p class="text-xs font-bold tracking-[0.12em] text-primary uppercase">Ditulis oleh</p>
    <a href={authorUrl(author.id)} class="mt-1 block text-lg font-bold text-text transition hover:text-primary">
      {author.data.name}
    </a>
    {author.data.role && <p class="text-sm text-text-secondary">{author.data.role}</p>}
    <p class="mt-2 text-sm leading-relaxed text-text-secondary">{author.data.bio}</p>
  </div>
</section>
