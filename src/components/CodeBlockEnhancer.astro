---
// CodeBlockEnhancer — header bar ala GitHub untuk SETIAP code block artikel.
//
// Dipasang sekali di BaseLayout (akhir <body>). Script berjalan sekali saat
// DOM siap, membungkus tiap `.prose pre` dengan `.code-block` + header yang
// berisi: label bahasa (dari `data-language` Shiki), tombol Salin, dan tombol
// Wrap. No-op bila halaman tidak punya `.prose pre` (mis. halaman Tools).
// Tidak menyentuh isi kode artikel; tidak ada dependency tambahan.
---

<style is:global>
  /* ---- Pembungkus code block: kartu + header ala GitHub ---- */
  .prose .code-block {
    margin: 1.7142857em 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  /* Pre Shiki di dalam kartu: margin/radius diambil alih pembungkus. */
  .prose .code-block pre {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.5rem 0.45rem 0.875rem;
    /* Latar header mengikuti latar tema GitHub Shiki (terang #f6f8fa,
       gelap #161b22) supaya menyatu dengan <pre> di bawahnya. */
    background-color: #f6f8fa;
    border-bottom: 1px solid var(--color-border);
  }

  .dark .code-block__header {
    background-color: #161b22;
  }

  .code-block__lang {
    min-width: 0;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-text-secondary);
  }

  .code-block__actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
  }

  .code-block__btn {
    padding: 0.2rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .code-block__btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Wrap aktif (default): tombol menyala aksen magenta LIME. */
  .code-block__btn--wrap.is-on {
    border-color: transparent;
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .code-block__btn--wrap.is-on:hover {
    background-color: var(--color-primary-hover);
    color: #ffffff;
  }

  /* ---- Wrap: default NYALA supaya kode panjang tidak meluber di HP. ----
     Saat wrap mati, <pre> kembali ke scroll horizontal (bawaan typography). */
  .prose .code-block.is-wrapped pre code {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .prose .code-block:not(.is-wrapped) pre {
    overflow-x: auto;
  }
</style>

<script is:inline>
  (function () {
    // Nama tampil untuk info string fence yang umum. Kunci huruf kecil.
    var LANG_NAMES = {
      js: 'JavaScript',
      javascript: 'JavaScript',
      mjs: 'JavaScript',
      cjs: 'JavaScript',
      jsx: 'JavaScript',
      ts: 'TypeScript',
      typescript: 'TypeScript',
      tsx: 'TypeScript',
      py: 'Python',
      python: 'Python',
      rb: 'Ruby',
      ruby: 'Ruby',
      go: 'Go',
      rs: 'Rust',
      rust: 'Rust',
      java: 'Java',
      c: 'C',
      cpp: 'C++',
      'c++': 'C++',
      cs: 'C#',
      csharp: 'C#',
      php: 'PHP',
      html: 'HTML',
      xml: 'XML',
      css: 'CSS',
      scss: 'SCSS',
      sass: 'Sass',
      less: 'Less',
      json: 'JSON',
      jsonc: 'JSON',
      json5: 'JSON',
      yaml: 'YAML',
      yml: 'YAML',
      toml: 'TOML',
      bash: 'Bash',
      sh: 'Shell',
      shell: 'Shell',
      zsh: 'Shell',
      powershell: 'PowerShell',
      ps1: 'PowerShell',
      sql: 'SQL',
      md: 'Markdown',
      markdown: 'Markdown',
      mdx: 'MDX',
      diff: 'Diff',
      dockerfile: 'Dockerfile',
      nginx: 'Nginx',
      graphql: 'GraphQL',
      text: 'Teks',
      txt: 'Teks',
      plaintext: 'Teks',
      plain: 'Teks',
      prompt: 'Prompt',
      console: 'Konsol',
      vim: 'Vim',
    };

    function displayLang(raw) {
      var lang = (raw || '').trim().toLowerCase();
      if (!lang) return 'Teks';
      if (LANG_NAMES[lang]) return LANG_NAMES[lang];
      // Tidak dikenal: tampilkan apa adanya dengan kapitalisasi rapi.
      return lang.charAt(0).toUpperCase() + lang.slice(1);
    }

    function enhance() {
      var pres = document.querySelectorAll('.prose pre');
      if (!pres.length) return; // No-op: halaman tanpa code block artikel.

      pres.forEach(function (pre) {
        if (pre.parentElement && pre.parentElement.classList.contains('code-block')) return;

        var code = pre.querySelector('code');
        var rawLang =
          pre.getAttribute('data-language') ||
          (code && code.getAttribute('data-language')) ||
          '';
        // Fallback: kelas `language-<lang>` bila data-language tidak ada.
        if (!rawLang) {
          var m = /language-([\w+-]+)/.exec(pre.className || '');
          if (m) rawLang = m[1];
        }

        var wrapper = document.createElement('div');
        wrapper.className = 'code-block is-wrapped'; // Wrap default NYALA.

        var header = document.createElement('div');
        header.className = 'code-block__header';

        var langLabel = document.createElement('span');
        langLabel.className = 'code-block__lang';
        langLabel.textContent = displayLang(rawLang);

        var actions = document.createElement('span');
        actions.className = 'code-block__actions';

        var wrapBtn = document.createElement('button');
        wrapBtn.type = 'button';
        wrapBtn.className = 'code-block__btn code-block__btn--wrap is-on';
        wrapBtn.textContent = 'Wrap';
        wrapBtn.setAttribute('aria-pressed', 'true');
        wrapBtn.setAttribute('aria-label', 'Bungkus baris kode (aktif)');
        wrapBtn.addEventListener('click', function () {
          var wrapped = wrapper.classList.toggle('is-wrapped');
          wrapBtn.classList.toggle('is-on', wrapped);
          wrapBtn.setAttribute('aria-pressed', String(wrapped));
          wrapBtn.setAttribute(
            'aria-label',
            wrapped ? 'Bungkus baris kode (aktif)' : 'Bungkus baris kode (mati)',
          );
        });

        var copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'code-block__btn code-block__btn--copy';
        copyBtn.textContent = 'Salin';
        copyBtn.setAttribute('aria-label', 'Salin kode');
        copyBtn.addEventListener('click', function () {
          var text = code ? code.innerText : pre.innerText;
          if (!navigator.clipboard || !navigator.clipboard.writeText) {
            copyBtn.textContent = 'Gagal menyalin';
            setTimeout(function () {
              copyBtn.textContent = 'Salin';
            }, 2000);
            return;
          }
          navigator.clipboard.writeText(text).then(
            function () {
              copyBtn.textContent = 'Disalin';
              setTimeout(function () {
                copyBtn.textContent = 'Salin';
              }, 2000);
            },
            function () {
              copyBtn.textContent = 'Gagal menyalin';
              setTimeout(function () {
                copyBtn.textContent = 'Salin';
              }, 2000);
            },
          );
        });

        actions.appendChild(wrapBtn);
        actions.appendChild(copyBtn);
        header.appendChild(langLabel);
        header.appendChild(actions);

        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(header);
        wrapper.appendChild(pre);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhance);
    } else {
      enhance();
    }
  })();
</script>
