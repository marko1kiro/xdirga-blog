---
import {
  categoryLabel,
  pricingLabel,
  shortDescription,
  toolSearchText,
  toolUrl,
  type Lang,
  type Tool,
} from '../../lib/tools-ui';

interface Props {
  tool: Tool;
  lang: Lang;
}

const { tool, lang } = Astro.props;
const data = tool.data;
const href = toolUrl(tool, lang);
const desc = shortDescription(tool, lang);
const featuredLabel = lang === 'id' ? 'Pilihan Editor' : "Editor's Pick";
// Atribut data-* dibaca JS ToolsSearch (filter/sort client-side). Tanpa JS,
// kartu tetap tampil penuh karena dirender server-side.
const searchText = toolSearchText(tool);
const published = data.publishedAt.toISOString();
---

<article
  data-tool-card
  data-slug={data.slug}
  data-search={searchText}
  data-pricing={data.pricingType}
  data-platforms={data.platforms.join(' ')}
  data-audience={data.audiences.join(' ')}
  data-published={published}
  data-rating={data.reviewScore}
  data-name={data.name.toLowerCase()}
  data-featured={data.featured ? '1' : '0'}
  class="group h-full"
>
  <a
    href={href}
    class="flex h-full flex-col rounded-2xl border border-border bg-surface p-4 transition hover:-translate-y-0.5 hover:border-primary hover:shadow-[0_12px_32px_-12px_rgba(192,38,211,0.35)] focus-visible:outline-2 focus-visible:outline-primary"
    aria-label={`${data.name} — ${desc}`}
  >
    <div class="flex items-start justify-between gap-2">
      {
        data.logo ? (
          <img
            src={data.logo}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            class="h-12 w-12 shrink-0 rounded-xl border border-border bg-surface-secondary object-contain p-1.5"
          />
        ) : (
          <span
            aria-hidden="true"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#c026d3] to-[#0891b2] text-xl font-bold text-white"
          >
            {data.name.charAt(0)}
          </span>
        )
      }
      {
        data.featured && (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-[#c026d3]/10 px-2 py-1 text-[0.68rem] font-bold text-primary">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
            {featuredLabel}
          </span>
        )
      }
    </div>

    <h3 class="mt-3 text-[1.02rem] font-semibold leading-snug text-text group-hover:text-primary">
      {data.name}
    </h3>
    <p class="mt-0.5 text-xs font-medium text-text-secondary">{data.vendor}</p>

    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-text-secondary">{desc}</p>

    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <span class="rounded-full bg-surface-secondary px-2.5 py-1 text-xs font-semibold text-text">
        {pricingLabel(data.pricingType, lang)}
      </span>
      <span class="rounded-full bg-surface-secondary px-2.5 py-1 text-xs font-semibold text-text-secondary">
        {categoryLabel(data.categories[0], lang)}
      </span>
      <span class="inline-flex items-center gap-1 rounded-full bg-surface-secondary px-2.5 py-1 text-xs font-semibold text-text">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        {data.reviewScore.toFixed(1)}
      </span>
    </div>

    {
      data.tags.length > 0 && (
        <p class="mt-3 line-clamp-1 text-xs text-text-secondary">{data.tags.slice(0, 3).join(' · ')}</p>
      )
    }
  </a>
</article>
