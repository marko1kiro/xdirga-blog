---
import { SCORE_DIMENSIONS, scoreToPercent, type Tool, type ToolLang } from '../../lib/tools';

interface Props {
  breakdown: Tool['data']['scoreBreakdown'];
  reviewScore: number;
  lang: ToolLang;
}

const { breakdown, reviewScore, lang } = Astro.props;
const isId = lang === 'id';
const percent = scoreToPercent(reviewScore);
---

<section aria-label={isId ? 'Penilaian editorial' : 'Editorial assessment'}>
  <div class="flex flex-wrap items-end gap-x-4 gap-y-2">
    <p class="font-display text-5xl leading-none font-semibold text-text">
      {reviewScore.toFixed(1)}
      <span class="text-2xl text-text-secondary">/10</span>
    </p>
    <p class="pb-1 text-sm text-text-secondary">
      {isId ? 'Skor editorial berbasis riset' : 'Research-based editorial score'}
    </p>
  </div>

  <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-surface-secondary" role="img" aria-label={`${reviewScore.toFixed(1)} / 10`}>
    <div class="h-full rounded-full bg-primary" style={`width: ${percent}%`} />
  </div>

  <dl class="mt-6 space-y-4">
    {
      SCORE_DIMENSIONS.map((dim) => {
        const value = breakdown[dim.key];
        const noEvidence = value === 0;
        return (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <dt class="text-sm font-semibold text-text">
                {isId ? dim.labelId : dim.labelEn}
                <span class="ml-2 font-normal text-text-secondary">
                  {isId ? dim.descriptionId : dim.descriptionEn}
                </span>
              </dt>
              <dd class="text-sm font-semibold text-text">
                {noEvidence ? (
                  <span class="rounded-full bg-surface-secondary px-2.5 py-0.5 text-xs font-semibold text-text-secondary">
                    {isId ? 'Bukti tidak cukup' : 'Insufficient evidence'}
                  </span>
                ) : (
                  `${value}/${dim.max}`
                )}
              </dd>
            </div>
            <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-surface-secondary">
              <div
                class:list={['h-full rounded-full', noEvidence ? 'bg-border' : 'bg-accent']}
                style={`width: ${Math.round((value / dim.max) * 100)}%`}
              />
            </div>
          </div>
        );
      })
    }
  </dl>

  <p class="mt-6 text-xs leading-relaxed text-text-secondary">
    {isId
      ? 'Penilaian editorial ini berbasis riset atas dokumentasi resmi, halaman harga, dan ketentuan vendor — bukan skor pengguna, bukan klaim vendor, dan bukan hands-on testing.'
      : 'This editorial assessment is based on research of official documentation, pricing pages, and vendor terms — not user scores, vendor claims, or hands-on testing.'}
  </p>
</section>
