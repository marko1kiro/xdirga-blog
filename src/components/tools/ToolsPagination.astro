---
interface Props {
  currentPage: number;
  lastPage: number;
  /** URL halaman n (1 = homepage arsip). */
  pageUrl: (page: number) => string;
  lang: 'en' | 'id';
}

const { currentPage, lastPage, pageUrl, lang } = Astro.props;
const prevLabel = lang === 'id' ? '← Sebelumnya' : '← Previous';
const nextLabel = lang === 'id' ? 'Berikutnya →' : 'Next →';
const ariaLabel = lang === 'id' ? 'Pagination' : 'Pagination';
---

{
  lastPage > 1 && (
    <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label={ariaLabel} data-tools-pagination>
      {currentPage > 1 && (
        <a
          href={pageUrl(currentPage - 1)}
          class="rounded-xl border border-border bg-surface px-4 py-3 text-sm font-semibold text-text transition hover:border-primary hover:text-primary"
        >
          {prevLabel}
        </a>
      )}
      {Array.from({ length: lastPage }, (_, i) => i + 1).map((page) => (
        <a
          href={pageUrl(page)}
          aria-current={page === currentPage ? 'page' : undefined}
          class:list={[
            'rounded-xl border px-4 py-3 text-sm font-semibold transition',
            page === currentPage
              ? 'border-primary bg-primary text-white'
              : 'border-border bg-surface text-text hover:border-primary hover:text-primary',
          ]}
        >
          {page}
        </a>
      ))}
      {currentPage < lastPage && (
        <a
          href={pageUrl(currentPage + 1)}
          class="rounded-xl border border-border bg-surface px-4 py-3 text-sm font-semibold text-text transition hover:border-primary hover:text-primary"
        >
          {nextLabel}
        </a>
      )}
    </nav>
  )
}
