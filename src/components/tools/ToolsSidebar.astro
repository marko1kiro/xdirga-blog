---
import {
  PLATFORM_VALUES,
  PRICING_VALUES,
  platformLabel,
  pricingLabel,
  type AudienceNavItem,
  type CategoryNavItem,
  type Lang,
} from '../../lib/tools-ui';

interface Props {
  /** 9 kategori + jumlah listing AKTUAL dari data (dibangun halaman via buildCategoryNav). */
  categories: CategoryNavItem[];
  allHref: string;
  allCount: number;
  lang: Lang;
  /** Slug kategori aktif di halaman arsip kategori; null = "Semua Tools". */
  activeSlug?: string | null;
  /** Jumlah aktual per harga (opsional; tanpa ini, angka tidak ditampilkan). */
  pricingCounts?: Record<string, number>;
  /** Jumlah aktual per platform (opsional). */
  platformCounts?: Record<string, number>;
  /** Audience hanya bila ada di data; kosong = seksi tidak render. */
  audiences?: AudienceNavItem[];
}

const {
  categories,
  allHref,
  allCount,
  lang,
  activeSlug = null,
  pricingCounts = {},
  platformCounts = {},
  audiences = [],
} = Astro.props;

const L = {
  categories: lang === 'id' ? 'Kategori' : 'Categories',
  allTools: lang === 'id' ? 'Semua Tools' : 'All Tools',
  filter: lang === 'id' ? 'Filter' : 'Filter',
  price: lang === 'id' ? 'Harga' : 'Price',
  platform: lang === 'id' ? 'Platform' : 'Platform',
  audience: lang === 'id' ? 'Pengguna' : 'Audience',
  reset: lang === 'id' ? 'Reset semua' : 'Reset all',
  toggleOpen: lang === 'id' ? 'Tampilkan filter & kategori' : 'Show filters & categories',
  toggleClose: lang === 'id' ? 'Sembunyikan filter & kategori' : 'Hide filters & categories',
} as const;
---

<div class="lg:sticky lg:top-24">
  <button
    type="button"
    id="tools-filter-toggle"
    aria-expanded="false"
    aria-controls="tools-filter-panel"
    data-label-open={L.toggleOpen}
    data-label-close={L.toggleClose}
    class="flex w-full items-center justify-between rounded-xl border border-border bg-surface px-4 py-3 text-sm font-semibold text-text transition hover:border-primary hover:text-primary lg:hidden"
  >
    <span class="inline-flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
      </svg>
      {L.filter}
    </span>
    <svg
      class="tools-filter-chevron"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>

  <div id="tools-filter-panel" class="mt-3 hidden lg:mt-0 lg:block" data-tools-filter-panel>
    <div class="rounded-2xl border border-border bg-surface p-4 sm:p-5">
      <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-text">{L.categories}</h2>
      <ul class="mt-3 space-y-0.5">
        <li>
          <a
            href={allHref}
            aria-current={activeSlug === null ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-surface-secondary hover:text-primary',
              activeSlug === null ? 'bg-surface-secondary text-primary' : 'text-text',
            ]}
          >
            {L.allTools}
            <span class="rounded-full bg-surface-secondary px-2 py-0.5 text-xs font-semibold text-text-secondary">
              {allCount}
            </span>
          </a>
        </li>
        {
          categories.map((cat) => (
            <li>
              <a
                href={cat.href}
                aria-current={activeSlug === cat.slug ? 'page' : undefined}
                class:list={[
                  'flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-surface-secondary hover:text-primary',
                  activeSlug === cat.slug ? 'bg-surface-secondary text-primary' : 'text-text',
                ]}
              >
                {cat.label}
                <span class="rounded-full bg-surface-secondary px-2 py-0.5 text-xs font-semibold text-text-secondary">
                  {cat.count}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-4 rounded-2xl border border-border bg-surface p-4 sm:p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold uppercase tracking-[0.12em] text-text">{L.filter}</h2>
        <button
          type="button"
          data-tools-reset
          class="text-xs font-semibold text-primary underline-offset-2 transition hover:text-primary-hover hover:underline"
        >
          {L.reset}
        </button>
      </div>

      <fieldset class="mt-4">
        <legend class="text-sm font-semibold text-text">{L.price}</legend>
        <ul class="mt-2 space-y-1.5">
          {
            PRICING_VALUES.map((value) => (
              <li>
                <label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-1 py-1 text-sm text-text transition hover:text-primary">
                  <input
                    type="checkbox"
                    value={value}
                    data-filter-group="pricing"
                    class="h-4 w-4 shrink-0 accent-[#c026d3]"
                  />
                  <span class="flex-1">{pricingLabel(value, lang)}</span>
                  {typeof pricingCounts[value] === 'number' && (
                    <span class="rounded-full bg-surface-secondary px-2 py-0.5 text-xs font-semibold text-text-secondary">
                      {pricingCounts[value]}
                    </span>
                  )}
                </label>
              </li>
            ))
          }
        </ul>
      </fieldset>

      <fieldset class="mt-5">
        <legend class="text-sm font-semibold text-text">{L.platform}</legend>
        <ul class="mt-2 space-y-1.5">
          {
            PLATFORM_VALUES.map((value) => (
              <li>
                <label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-1 py-1 text-sm text-text transition hover:text-primary">
                  <input
                    type="checkbox"
                    value={value}
                    data-filter-group="platform"
                    class="h-4 w-4 shrink-0 accent-[#c026d3]"
                  />
                  <span class="flex-1">{platformLabel(value)}</span>
                  {typeof platformCounts[value] === 'number' && (
                    <span class="rounded-full bg-surface-secondary px-2 py-0.5 text-xs font-semibold text-text-secondary">
                      {platformCounts[value]}
                    </span>
                  )}
                </label>
              </li>
            ))
          }
        </ul>
      </fieldset>

      {
        audiences.length > 0 && (
          <fieldset class="mt-5">
            <legend class="text-sm font-semibold text-text">{L.audience}</legend>
            <ul class="mt-2 space-y-1.5">
              {audiences.map((aud) => (
                <li>
                  <label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-1 py-1 text-sm text-text transition hover:text-primary">
                    <input
                      type="checkbox"
                      value={aud.value}
                      data-filter-group="audience"
                      class="h-4 w-4 shrink-0 accent-[#c026d3]"
                    />
                    <span class="flex-1">{aud.label}</span>
                    <span class="rounded-full bg-surface-secondary px-2 py-0.5 text-xs font-semibold text-text-secondary">
                      {aud.count}
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          </fieldset>
        )
      }
    </div>
  </div>
</div>

<style>
  .tools-filter-chevron {
    display: block;
    transition: transform 0.2s ease;
  }
  #tools-filter-toggle[aria-expanded='true'] .tools-filter-chevron {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('tools-filter-toggle');
    var panel = document.getElementById('tools-filter-panel');
    if (!btn || !panel) return;
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.setAttribute(
        'aria-label',
        !open ? btn.getAttribute('data-label-close') : btn.getAttribute('data-label-open'),
      );
      panel.classList.toggle('hidden', open);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        btn.setAttribute('aria-expanded', 'false');
        panel.classList.add('hidden');
        btn.focus();
      }
    });
  })();
</script>
