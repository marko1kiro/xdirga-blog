---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="my-6 rounded-2xl border border-border bg-surface-secondary p-5 sm:p-6">
  <p class="text-sm font-bold text-text">{title}</p>
  <div class="mt-2 text-[0.95rem] leading-relaxed text-text-secondary [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</aside>
