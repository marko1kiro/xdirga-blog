---
interface Props {
  type?: 'info' | 'tip' | 'warning';
  title?: string;
}

const { type = 'info', title } = Astro.props;
const styles = {
  info: 'border-primary bg-accent/50',
  tip: 'border-primary bg-accent/50',
  warning: 'border-amber-600/60 bg-amber-50 dark:bg-amber-950/30',
};
const label = title ?? (type === 'tip' ? 'Tips' : type === 'warning' ? 'Perhatian' : 'Catatan');
---

<aside class:list={['my-6 rounded-r-xl border-l-4 px-5 py-4', styles[type]]} role="note">
  <p class="text-sm font-bold text-text">{label}</p>
  <div class="mt-1.5 text-[0.95rem] leading-relaxed text-text [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</aside>
