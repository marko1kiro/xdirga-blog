---
interface Props {
  cite?: string;
}

const { cite } = Astro.props;
---

<blockquote class="my-8 border-l-4 border-primary pl-5 font-display text-[1.35rem] leading-relaxed font-medium text-text italic sm:text-[1.5rem]">
  <slot />
  {cite && <footer class="mt-3 font-sans text-sm font-normal not-italic text-text-secondary">— {cite}</footer>}
</blockquote>
