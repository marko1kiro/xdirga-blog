---
import CoverPicture from './CoverPicture.astro';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  eager?: boolean;
}

const { src, alt, caption, eager = false } = Astro.props;
---

<figure class="mt-8">
  <CoverPicture
    src={src}
    alt={alt}
    sizes="(max-width: 1023px) 100vw, 880px"
    eager={eager}
    class="aspect-[16/9] w-full rounded-2xl border border-border object-cover sm:aspect-[2/1]"
  />
  {
    caption && (
      <figcaption class="mt-2.5 text-center text-[0.8rem] text-text-secondary">{caption}</figcaption>
    )
  }
</figure>
