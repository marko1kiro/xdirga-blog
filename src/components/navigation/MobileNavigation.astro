---
import type { NavItem } from '../../config/navigation';

interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
---

<!-- Drawer seluler: dirender sebagai sibling <header> (bukan anaknya) supaya
     position: fixed tidak terjebak containing block dari backdrop-blur header. -->
<div id="mobile-menu" class="lg:hidden" hidden>
  <div
    class="fixed inset-0 z-50 bg-black/50 opacity-0 transition-opacity duration-200"
    data-mobile-overlay
    aria-hidden="true"
  >
  </div>
  <aside
    class="fixed inset-y-0 right-0 z-50 flex w-[min(92vw,400px)] translate-x-full flex-col bg-surface shadow-2xl transition-transform duration-200 ease-out"
    role="dialog"
    aria-modal="true"
    aria-label="Menu navigasi"
    data-mobile-drawer
  >
    <div
      class="flex shrink-0 items-center justify-between border-b border-border px-5 pb-3.5 pt-[max(0.875rem,env(safe-area-inset-top))]"
    >
      <span class="flex items-center" aria-hidden="true">
        <img
          src="/logo-xdirga-blog-light.png"
          alt=""
          width="880"
          height="146"
          class="block h-6 w-auto min-[400px]:h-7 dark:hidden"
        />
        <img
          src="/logo-xdirga-blog-dark.png"
          alt=""
          width="880"
          height="146"
          class="hidden h-6 w-auto min-[400px]:h-7 dark:block"
        />
      </span>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Tutup menu"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-border text-text-secondary transition hover:border-primary hover:text-primary"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <nav
      class="flex-1 overflow-y-auto px-5 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-2"
      aria-label="Navigasi seluler"
    >
      <a
        href="/"
        aria-current={currentPath === '/' ? 'page' : undefined}
        class:list={[
          'block rounded-lg px-3 py-3 text-[0.95rem] font-medium transition hover:bg-surface-secondary',
          currentPath === '/' ? 'text-primary' : 'text-text',
        ]}
      >
        Beranda
      </a>

      {
        items.map((item) => {
          const active = currentPath.startsWith(item.href);
          return (
            <div class="border-b border-border/60 last:border-b-0">
              <div class="flex items-center">
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'min-h-[44px] flex-1 rounded-lg px-3 py-3 text-[0.95rem] font-medium transition hover:bg-surface-secondary',
                    active ? 'text-primary' : 'text-text',
                  ]}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  data-accordion-btn={item.slug}
                  aria-expanded="false"
                  aria-controls={`acc-${item.slug}`}
                  aria-label={`Buka submenu ${item.label}`}
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-text-secondary transition hover:bg-surface-secondary hover:text-text"
                >
                  <svg
                    class="acc-chevron"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </button>
              </div>
              <div
                id={`acc-${item.slug}`}
                class="acc-panel"
                data-accordion-panel={item.slug}
              >
                <div class="min-h-0 overflow-hidden">
                  <div class="px-3 pb-4 pt-1">
                    <p class="text-[0.7rem] font-bold uppercase tracking-[0.14em] text-text-secondary">
                      Topik
                    </p>
                    <ul class="mt-1">
                      {item.tags.map((tag) => (
                        <li>
                          <a
                            href={tag.href}
                            class="flex min-h-[44px] items-center justify-between gap-2 rounded-lg px-2 py-2 text-sm font-medium text-text-secondary transition hover:bg-surface-secondary hover:text-primary"
                          >
                            {tag.label}
                            <span class="rounded-full bg-surface-secondary px-2 py-0.5 text-xs font-semibold text-text-secondary">
                              {tag.count}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <p class="mt-3 text-[0.7rem] font-bold uppercase tracking-[0.14em] text-text-secondary">
                      Terbaru di {item.label}
                    </p>
                    <ul class="mt-1">
                      {item.latest.map((post) => (
                        <li>
                          <a
                            href={post.href}
                            class="block min-h-[44px] rounded-lg px-2 py-2.5 text-sm font-medium leading-snug text-text-secondary transition hover:bg-surface-secondary hover:text-primary"
                          >
                            {post.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a
                      href={item.href}
                      class="mt-2 inline-flex min-h-[44px] items-center gap-1 px-2 text-sm font-semibold text-primary"
                    >
                      Lihat Semua {item.label} →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }

      <a
        href="/tentang/"
        aria-current={currentPath.startsWith('/tentang/') ? 'page' : undefined}
        class:list={[
          'block rounded-lg px-3 py-3 text-[0.95rem] font-medium transition hover:bg-surface-secondary',
          currentPath.startsWith('/tentang/') ? 'text-primary' : 'text-text-secondary',
        ]}
      >
        Tentang
      </a>
      <a
        href="/kategori/"
        class="mt-1 block rounded-lg px-3 py-3 text-[0.95rem] font-medium text-text-secondary transition hover:bg-surface-secondary hover:text-text"
      >
        Semua Kategori →
      </a>
    </nav>

    <div class="shrink-0 border-t border-border px-5 py-4">
      <a
        href="/search/"
        class="flex min-h-[44px] items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-hover"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.5" y2="16.5" />
        </svg>
        Cari Artikel
      </a>
    </div>
  </aside>
</div>

<style>
  .acc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.22s ease;
  }
  .acc-panel[data-open='true'] {
    grid-template-rows: 1fr;
  }
  .acc-chevron {
    display: block;
    transition: transform 0.2s ease;
  }
  [data-accordion-btn][aria-expanded='true'] .acc-chevron {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  (function () {
    var menuBtn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!menuBtn || !menu) return;
    var overlay = menu.querySelector('[data-mobile-overlay]');
    var drawer = menu.querySelector('[data-mobile-drawer]');
    var closeBtn = document.getElementById('mobile-menu-close');
    var lastFocused = null;
    var isOpen = false;

    function lockScroll(lock) {
      document.body.style.overflow = lock ? 'hidden' : '';
    }
    function openMenu() {
      lastFocused = document.activeElement;
      menu.hidden = false;
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          overlay.classList.add('opacity-100');
          drawer.classList.remove('translate-x-full');
        });
      });
      menuBtn.setAttribute('aria-expanded', 'true');
      menuBtn.setAttribute('aria-label', 'Tutup menu');
      lockScroll(true);
      isOpen = true;
      setTimeout(function () {
        if (closeBtn) closeBtn.focus();
      }, 220);
    }
    function closeMenu() {
      overlay.classList.remove('opacity-100');
      drawer.classList.add('translate-x-full');
      menuBtn.setAttribute('aria-expanded', 'false');
      menuBtn.setAttribute('aria-label', 'Buka menu');
      lockScroll(false);
      isOpen = false;
      setTimeout(function () {
        menu.hidden = true;
      }, 220);
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    menuBtn.addEventListener('click', function () {
      if (isOpen) closeMenu();
      else openMenu();
    });
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });

    Array.prototype.slice
      .call(menu.querySelectorAll('[data-accordion-btn]'))
      .forEach(function (btn) {
        btn.addEventListener('click', function () {
          var panel = document.getElementById(btn.getAttribute('aria-controls'));
          if (!panel) return;
          var expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          panel.setAttribute('data-open', String(!expanded));
        });
      });

    Array.prototype.slice.call(menu.querySelectorAll('a[href]')).forEach(function (a) {
      a.addEventListener('click', function () {
        if (isOpen) closeMenu();
      });
    });

    // Focus trap ringan di dalam drawer.
    drawer.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab' || !isOpen) return;
      var focusables = Array.prototype.slice
        .call(drawer.querySelectorAll('a[href], button:not([disabled])'))
        .filter(function (el) {
          return el.offsetParent !== null;
        });
      if (!focusables.length) return;
      var first = focusables[0];
      var last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
