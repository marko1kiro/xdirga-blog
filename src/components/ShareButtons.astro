---
/**
 * ShareButtons — tombol share ikon saja (aturan durable, 2026-11-14).
 * Platform: WhatsApp, Facebook, X, Telegram, LinkedIn, Pinterest, Threads
 * + Salin Tautan. Ikon SVG inline (simple-icons, tanpa library eksternal),
 * aria-label untuk aksesibilitas, anchor biasa (tanpa JS berat).
 * Salin tautan pakai Clipboard API modern (tanpa document.execCommand).
 */
interface Props {
  url: string;
  title: string;
  image?: string;
}

const { url, title, image } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const shareText = encodeURIComponent(`${title} ${url}`);
const encodedImage = image ? encodeURIComponent(image) : '';

