---
/**
 * Formulir langganan email lewat Buttondown.
 *
 * Form HTML biasa yang POST langsung ke Buttondown. Tanpa JavaScript
 * dan tanpa pesan sukses palsu. Kalau langganan berhasil, Buttondown
 * menampilkan halaman konfirmasinya sendiri.
 *
 * Selama username Buttondown masih kosong, komponen ini tidak
 * merender apa pun, bukan div kosong.
 */
import { buttondownSubscribeUrl, NEWSLETTER_ENABLED } from '../lib/newsletter';

interface Props {
  /** Bahasa label dan catatan; default 'id'. */
  lang?: 'id' | 'en';
}

const { lang = 'id' } = Astro.props;

const copy =
  lang === 'en'
    ? {
        heading: 'Subscribe by email',
        label: 'Your email address',
        placeholder: 'name@email.com',
        button: 'Subscribe',
        note: 'Your email is only used to send you new articles, and you can unsubscribe anytime.',
      }
    : {
        heading: 'Langganan email',
        label: 'Alamat email lo',
        placeholder: 'nama@email.com',
        button: 'Langganan',
        note: 'Email lo cuma dipakai buat kirim tulisan baru, dan lo bisa berhenti kapan saja.',
      };
---

{
  NEWSLETTER_ENABLED && (
    <form
      action={buttondownSubscribeUrl()}
      method="post"
      class="rounded-2xl border border-border bg-accent-soft p-6 sm:p-8"
    >
      <h2 class="font-display text-xl font-semibold text-text sm:text-2xl">{copy.heading}</h2>
      <label for="subscribe-email" class="mt-4 block text-sm font-medium text-text">
        {copy.label}
      </label>
      <div class="mt-2 flex flex-col gap-2.5 sm:flex-row">
        <input
          id="subscribe-email"
          type="email"
          name="email"
          required
          placeholder={copy.placeholder}
          autocomplete="email"
          class="w-full min-w-0 flex-1 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm text-text placeholder:text-text-secondary focus:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        />
        <button
          type="submit"
          class="inline-flex shrink-0 items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {copy.button}
        </button>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-text-secondary">{copy.note}</p>
    </form>
  )
}
