---
import CoverPicture from '../CoverPicture.astro';
import type { Article } from '../../lib/articles';
import { articleUrl, getCategory } from '../../lib/articles';
import { formatDateShortLang, type Lang } from '../../lib/i18n';

interface Props {
  post: Article;
  eager?: boolean;
  /** Bahasa format tanggal; default 'id'. */
  lang?: Lang;
}

const { post, eager = false, lang = 'id' } = Astro.props;
const category = await getCategory(post.data.category);
---

<article class="group overflow-hidden rounded-2xl border border-border bg-surface transition hover:border-primary/60 hover:shadow-[0_12px_32px_rgba(16,51,61,0.09)]">
  <a href={articleUrl(post)} class="block">
    <CoverPicture
      src={post.data.cover}
      alt={post.data.coverAlt}
      sizes="(max-width: 1023px) 100vw, 800px"
      eager={eager}
      class="aspect-[16/9] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
    />
    <div class="p-6 sm:p-7">
      <p class="text-xs font-bold tracking-[0.12em] text-primary uppercase">{category?.data.name ?? post.data.category}</p>
      <h3 class="mt-2.5 font-display text-[1.9rem] leading-[1.15] font-semibold text-text transition group-hover:text-primary sm:text-[2.35rem]">
        {post.data.title}
      </h3>
      <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-text-secondary">{post.data.description}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8rem] text-text-secondary">
        <span class="font-medium text-text">{post.data.author === 'xdirga' ? 'Marko' : post.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.publishedAt.toISOString()}>{formatDateShortLang(post.data.publishedAt, lang)}</time>
      </p>
    </div>
  </a>
</article>
