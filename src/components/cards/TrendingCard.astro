---
import type { Article } from '../../lib/articles';
import { articleUrl } from '../../lib/articles';
import { formatDateShortLang, type Lang } from '../../lib/i18n';

interface Props {
  post: Article;
  rank: number;
  /** Bahasa format tanggal; default 'id'. */
  lang?: Lang;
}

const { post, rank, lang = 'id' } = Astro.props;
---

<article class="group flex gap-4 border-b border-border py-4 first:pt-0 last:border-b-0 last:pb-0">
  <span class="font-display text-[1.9rem] leading-none font-semibold text-primary transition group-hover:text-primary-hover" aria-hidden="true">
    {String(rank).padStart(2, '0')}
  </span>
  <div class="min-w-0">
    <a href={articleUrl(post)} class="block">
      <h3 class="text-[1rem] leading-snug font-bold text-text transition group-hover:text-primary">
        {post.data.title}
      </h3>
    </a>
    <p class="mt-1.5 text-xs text-text-secondary">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDateShortLang(post.data.publishedAt, lang)}</time>
    </p>
  </div>
</article>
