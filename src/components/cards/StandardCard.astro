---
import CoverPicture from '../CoverPicture.astro';
import type { Article } from '../../lib/articles';
import { articleUrl, getCategory, readingMinutes } from '../../lib/articles';
import { formatDateShortLang, ui, type Lang } from '../../lib/i18n';

interface Props {
  post: Article;
  /** Bahasa label kartu ("menit baca" / tanggal); default 'id'. */
  lang?: Lang;
}

const { post, lang = 'id' } = Astro.props;
const t = ui(lang);
const category = await getCategory(post.data.category);
const minutes = readingMinutes(post.body ?? '');
---

<article class="group overflow-hidden rounded-2xl border border-border bg-surface transition hover:border-primary/60 hover:shadow-[0_8px_24px_rgba(16,51,61,0.08)]">
  <a href={articleUrl(post)} class="block">
    <CoverPicture
      src={post.data.cover}
      alt={post.data.coverAlt}
      sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 400px"
      class="aspect-[16/9] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
    />
    <div class="p-5">
      <p class="text-[0.7rem] font-bold tracking-[0.12em] text-primary uppercase">{category?.data.name ?? post.data.category}</p>
      <h3 class="mt-2 text-[1.08rem] leading-snug font-bold text-text transition group-hover:text-primary">
        {post.data.title}
      </h3>
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-text-secondary">{post.data.description}</p>
      <p class="mt-3.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-text-secondary">
        <time datetime={post.data.publishedAt.toISOString()}>{formatDateShortLang(post.data.publishedAt, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{t.minRead(minutes)}</span>
      </p>
    </div>
  </a>
</article>
