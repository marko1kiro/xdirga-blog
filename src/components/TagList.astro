---
import { tagUrl } from '../lib/articles';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2" aria-label="Tag artikel">
      {tags.map((tag) => (
        <li>
          <a
            href={tagUrl(tag)}
            class="inline-block rounded-full border border-border bg-surface-secondary px-3 py-1 text-xs font-medium text-text-secondary transition hover:border-primary hover:text-primary"
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
