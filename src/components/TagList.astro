---
import { tagUrlFor, ui, type Lang } from '../lib/i18n';

interface Props {
  tags: string[];
  /** Bahasa tujuan tautan tag (/tag/ vs /en/tag/); default 'id'. */
  lang?: Lang;
}

const { tags, lang = 'id' } = Astro.props;
const t = ui(lang);
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2" aria-label={t.tagsAria}>
      {tags.map((tag) => (
        <li>
          <a
            href={tagUrlFor(tag, lang)}
            class="inline-block rounded-full border border-border bg-surface-secondary px-3 py-1 text-xs font-medium text-text-secondary transition hover:border-primary hover:text-primary"
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
