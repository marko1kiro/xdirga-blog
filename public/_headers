# Cache-Control edge + browser untuk xdirga.xyz (Cloudflare Pages)
# HTML: edge 5 menit, browser selalu revalidasi. Pages purge cache tiap deploy,
# jadi konten baru tetap langsung tampil; kalaupun purge kelewat, basi mentok 5 menit.
# Gambar/cover (nama file stabil, BUKAN fingerprinted): 1 hari, BUKAN immutable.
# Hanya aset _astro/* yang fingerprinted (hash di nama file) boleh immutable 1 tahun.
/*
  Cache-Control: public, s-maxage=300, max-age=0, must-revalidate

/covers/*
  Cache-Control: public, s-maxage=86400, max-age=86400

/og-default.jpg
  Cache-Control: public, s-maxage=86400, max-age=86400

/favicon.png
  Cache-Control: public, s-maxage=86400, max-age=86400

/favicon.ico
  Cache-Control: public, s-maxage=86400, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, s-maxage=86400, max-age=86400

/logo-xdirga-blog-light.png
  Cache-Control: public, s-maxage=86400, max-age=86400

/logo-xdirga-blog-dark.png
  Cache-Control: public, s-maxage=86400, max-age=86400

/avatars/*
  Cache-Control: public, s-maxage=86400, max-age=86400

/pagefind/*
  Cache-Control: public, s-maxage=86400, max-age=86400

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
