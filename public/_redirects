# Redirect rute lama v1 ke rute baru v2 (301 permanen)
/blog/* /artikel/:splat 301
/tags/* /tag/:splat 301
/tags/ /tag/ 301
# Kategori Lainnya dihapus 2026-11-14, artikelnya pindah ke Berita
# Aturan tanpa slash diperlukan terpisah: /kategori/lainnya/* hanya cocok
# bila ada slash, jadi varian tanpa slash tadinya lolos jadi 404.
/kategori/lainnya /kategori/berita/ 301
/kategori/lainnya/ /kategori/berita/ 301
/kategori/lainnya/* /kategori/berita/ 301
# Artikel Selamat Datang dihapus permanen 2026-11-14 (bukan berita, sudah ada Halaman Tentang)
/artikel/selamat-datang-di-blog-xdirga /tentang/ 301
/artikel/selamat-datang-di-blog-xdirga/ /tentang/ 301
